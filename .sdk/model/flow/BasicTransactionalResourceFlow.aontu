# BasicTransactionalResourceFlow

main: kit: flow: BasicTransactionalResourceFlow:
{
  entity: "transactional_resource",
  kind: "basic",
  name: "BasicTransactionalResourceFlow",
  step: [
    {
      i: {
        ref: "transactional_resource_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "transactional_resource_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "transactional_resource_ref01",
        srcdatavar: "transactional_resource_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "transactional_resource01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-transactional_resource_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTransactionalResourceFlow"
}