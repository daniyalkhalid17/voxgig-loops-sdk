# BasicThemeFlow

main: kit: flow: BasicThemeFlow:
{
  entity: "theme",
  kind: "basic",
  name: "BasicThemeFlow",
  step: [
    {
      i: {
        ref: "theme_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "theme_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "theme_ref01",
        srcdatavar: "theme_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "theme01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-theme_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicThemeFlow"
}