# BasicApiKeyFlow

main: kit: flow: BasicApiKeyFlow:
{
  entity: "api_key",
  kind: "basic",
  name: "BasicApiKeyFlow",
  step: [
    {
      i: {
        ref: "api_key_ref01",
        srcdatavar: "api_key_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-api_key_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicApiKeyFlow"
}