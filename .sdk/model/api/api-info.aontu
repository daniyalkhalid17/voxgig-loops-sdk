          url: "https://app.loops.so/api"
        }
      ]
      summary: "This is the OpenAPI Spec for the [Loops API](https://loops.so/docs/api)."
      title: "Loops OpenAPI Spec"
      version: "1.22.4"
      website: "https://app.loops.so"
    }
  }
