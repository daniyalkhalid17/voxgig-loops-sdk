# Entity: event_pattern

main: kit: entity: event_pattern: {

  alias: field: {}

  fields: {
    eventName: {
      h: "Event Name"
      n: "eventName"
      r: true
      sh: "The name of the event pattern."
      t: "`$STRING`"
    }
    eventProperties: {
      h: "Event Properties"
      n: "eventProperties"
      r: true
      sh: "The properties of the event pattern, which can be used in emails."
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the event pattern."
      t: "`$STRING`"
    }
    incomingWebhookPlatform: {
      h: "Incoming Webhook Platform"
      n: "incomingWebhookPlatform"
      r: true
      sh: "The platform that sent this event pattern, if the event pattern is from an incoming webhook."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
  }

