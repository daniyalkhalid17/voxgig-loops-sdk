# Entity: transactional_metric

main: kit: entity: transactional_metric: {

  alias: field: {}

  fields: {
    deliveries: {
      h: "Deliveries"
      n: "deliveries"
      r: true
      sh: "Number of sends delivered."
      t: "`$INTEGER`"
    }
    hardBounces: {
      h: "Hard Bounces"
      n: "hardBounces"
      r: true
      sh: "Number of sends that hard bounced."
      t: "`$INTEGER`"
    }
    sends: {
      h: "Sends"
      n: "sends"
      r: true
      sh: "Number of sends."
      t: "`$INTEGER`"
    }
    softBounces: {
      h: "Soft Bounces"
      n: "softBounces"
      r: true
      sh: "Number of sends that soft bounced."
      t: "`$INTEGER`"
    }
    spamReports: {
      h: "Spam Reports"
      n: "spamReports"
      r: true
      sh: "Number of sends reported as spam."
      t: "`$INTEGER`"
    }
  }

  name: "transactional_metric"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/transactional-emails/{transactionalId}/metrics"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "transactional_email_id"
                or: "transactionalId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/transactional-emails/{transactionalId}/metrics"
          q: {
            exist: [
              "transactional_email_id"
            ]
          }
          r: {
            param: {
              transactionalId: "transactional_email_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "transactional-emails"
            }
            {
              var: "transactional_email_id"
            }
            {
              lit: "metrics"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
