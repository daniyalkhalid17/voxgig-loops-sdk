# Entity: simplified_workflow

main: kit: entity: simplified_workflow: {

  alias: field: {}

  fields: {
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "ISO 8601 timestamp for when the workflow was created."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The description of the workflow."
      t: "`$STRING`"
    }
    expectedRevisionId: {
      h: "Expected Revision Id"
      n: "expectedRevisionId"
      r: true
      sh: "The workflow revision token returned by the latest workflow read or mutation."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the workflow."
      t: "`$STRING`"
    }
