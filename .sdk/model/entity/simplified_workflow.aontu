        create: {
          req: true
          type: "`$STRING`"
        }
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "The name of the workflow."
      t: "`$STRING`"
    }
    nodes: {
      h: "Nodes"
      n: "nodes"
      r: true
      sh: "A map of node IDs to simplified node objects."
      t: "`$OBJECT`"
      union: {
        branches: 3
        count: 1
        depth: 11
      }
    }
    rootNodeId: {
      h: "Root Node Id"
      n: "rootNodeId"
      r: true
      sh: "The ID of the root node in the workflow graph."
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      t: "`$STRING`"
    }
    updatedAt: {
      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "ISO 8601 timestamp for when the workflow was last updated."
      t: "`$STRING`"
    }
    url: {
      fo: "uri"
      h: "Url"
      n: "url"
      r: true
      sh: "The URL of the workflow in the Loops app."
      t: "`$STRING`"
    }
    workflowRevisionId: {
      h: "Workflow Revision Id"
      n: "workflowRevisionId"
      r: true
      sh: "The current workflow revision token."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "simplified_workflow"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
