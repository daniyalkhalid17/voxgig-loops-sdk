        create: {
          req: false
          type: [
            "`$ONE`"
            [
              "`$STRING`"
              "`$NULL`"
            ]
          ]
        }
      }
      r: true
      sh: "The ID of the mailing list the workflow sends to."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    name: {
      h: "Name"
      n: "name"
