    }
    mailingListId: {
      h: "Mailing List Id"
      n: "mailingListId"
      op: {
        create: {
          req: false
          type: [
            "`$ONE`"
            [
              "`$STRING`"
              "`$NULL`"
            ]
          ]
        }
      }
      r: true
      sh: "The ID of the mailing list this campaign sends to, if set."
