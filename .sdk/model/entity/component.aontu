# Entity: component

main: kit: entity: component: {

  alias: field: {}

  fields: {
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the component."
      t: "`$STRING`"
    }
    lmx: {
      h: "Lmx"
      n: "lmx"
      r: true
      sh: "The component body serialized as LMX."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the component."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "component"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "lmx"
            "name"
          ]
          co: {
            id: "POST /v1/components"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/components"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "components"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/components"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "cursor"
                or: "cursor"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "per_page"
                or: "perPage"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/components"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "components"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/components/{componentId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "componentId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/components/{componentId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              componentId: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "components"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
