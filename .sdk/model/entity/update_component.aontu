      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "update_component"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "lmx"
            "name"
          ]
          co: {
            id: "POST /v1/components/{componentId}"
