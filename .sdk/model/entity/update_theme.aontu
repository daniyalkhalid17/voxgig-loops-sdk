# Entity: update_theme

main: kit: entity: update_theme: {

  alias: field: {}

  fields: {
    affectedEmailCount: {
      h: "Affected Email Count"
      n: "affectedEmailCount"
      r: true
      sh: "The number of emails using this theme that are affected by the style change."
      t: "`$NUMBER`"
    }
    createdAt: {
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "ISO 8601 timestamp for when the theme was created."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of the theme."
      t: "`$STRING`"
    }
    isDefault: {
      h: "Is Default"
      n: "isDefault"
      r: true
      sh: "Whether this theme is the team's default."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The name of the theme."
      t: "`$STRING`"
    }
    styles: {
      h: "Styles"
      n: "styles"
      op: {
        create: {
          req: false
          type: "`$OBJECT`"
        }
      }
      r: true
      sh: "Flat map of style attributes, matching the attribute names accepted by the LMX `<Style />` tag."
      t: "`$OBJECT`"
    }
    updatedAt: {
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "ISO 8601 timestamp for when the theme was last updated."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "update_theme"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "name"
            "styles"
          ]
          co: {
            id: "POST /v1/themes/{themeId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "themeId"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/themes/{themeId}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              themeId: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "themes"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
